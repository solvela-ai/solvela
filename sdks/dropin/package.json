{
  "name": "@solvela/dropin",
  "version": "0.1.0",
  "description": "Claude Code drop-in signing sidecar — point ANTHROPIC_BASE_URL at localhost; it signs a spend-down-channel voucher per request and relays the gateway's native response",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "solvela-dropin": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "node --import tsx/esm --test tests/server.test.ts tests/open-close.test.ts",
    "typecheck": "tsc --noEmit",
    "prebuild": "node ../signer-core/scripts/ensure-built.mjs",
    "pretest": "node ../signer-core/scripts/ensure-built.mjs",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "claude-code",
    "solana",
    "usdc",
    "x402",
    "payment-channel",
    "sidecar"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solvela-ai/solvela.git",
    "directory": "sdks/dropin"
  },
  "dependencies": {
    "@solvela/signer-core": "file:../signer-core",
    "@solana/web3.js": "^1.87.0",
    "@solana/spl-token": "^0.4.0",
    "bs58": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "ip-address": "^10.1.1"
  }
}
