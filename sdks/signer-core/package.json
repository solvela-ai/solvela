{
  "name": "@solvela/signer-core",
  "version": "0.2.0",
  "description": "Shared x402 protocol library: signing, parsing, scheme filtering, stub-header guards, and error sanitization",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "node --import tsx/esm --test tests/parse-402.test.ts tests/scheme-filter.test.ts tests/stub-guard.test.ts tests/redact.test.ts tests/sign.test.ts tests/escrow.test.ts tests/channel.test.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "tsc"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.0",
    "@solana/web3.js": "^1.87.0",
    "bs58": "^6.0.0",
    "valibot": "^1.4.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solvela-ai/solvela.git",
    "directory": "sdks/signer-core"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
