{
  "mcpServers": {
    "stripe": {
      "type": "http",
      "url": "https://mcp.stripe.com/"
    },
    "solana-mcp-server": {
      "type": "http",
      "url": "https://mcp.solana.com/mcp"
    },
    "helius": {
      "command": "npx",
      "args": ["helius-mcp@1.3.0"],
      "env": {
        "HELIUS_API_KEY": "${HELIUS_API_KEY}"
      }
    }
  }
}
